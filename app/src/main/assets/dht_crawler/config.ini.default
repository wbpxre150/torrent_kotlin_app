# DHT Crawler Configuration File
# Architecture: thread trees bootstrap solely from the BEP51 cache.
# On cold start, the supervisor runs a parallel URL bootstrap to
# populate the cache; on warm restart trees sample from it directly.
# Lines starting with # are comments.
# ==== DHT Settings ====
dht_port=6881

# ==== Database & Logging ====
db_path=data/torrents.db
log_level=INFO

# ==== HTTP API ====
# Port for the HTTP API server (the app manages this key: 8081 on loopback so
# the authenticated reverse proxy can own the LAN port 8080)
http_port = 8081
# Address to bind the HTTP API server to (default: 0.0.0.0 = all interfaces;
# set to 127.0.0.1 to restrict to loopback, e.g. behind an authenticated proxy;
# Stage 10 keeps it on loopback — LAN access goes through the authenticated proxy)
http_bind = 127.0.0.1
# Process nice level applied at startup via setpriority (default: 0, range -20..19;
# positive values make the crawler yield CPU to other processes)
nice_level = 10

# ==== Bloom Filter Settings ====
bloom_enabled=1
bloom_capacity=30000000
failure_bloom_capacity=30000000
# failure_strike_count: failures before permanent block (1=immediate, 2=two-strike). Default: 2
failure_strike_count=2
bloom_error_rate=0.001
bloom_persist=1
# bloom_persist_interval_sec: min seconds between bloom-filter disk saves (0 = every flush, else 30-3600). Default: 300
bloom_persist_interval_sec=300
bloom_path=data/bloom.dat

# ==== Batched Writes ====
batch_size=500
flush_interval=300

# ==== Daily Backup ====
# Backups are off on Android: the three backup flags below are pinned to 0 by
# the app's config writer (CrawlerConfig) and no backup targets are configured.
backup_enabled = 0

# SSH incremental backup: streams daily new rows as compressed SQL to a remote server.
# Files named incremental_YYYYMMDD_START-END.sql.zst. Runs in background thread.
# Requires: zstd and sqlite3 on PATH, passwordless SSH key auth, host in known_hosts.
ssh_backup_enabled = 0
ssh_bookmark_path=data/ssh_backup_ids.txt

# rclone incremental backup: streams daily new rows as compressed SQL via rclone rcat.
# Files named incremental_YYYYMMDD_START-END.sql.zst. Runs in background thread.
# Requires: zstd, sqlite3, and rclone on PATH with a configured remote.
rclone_backup_enabled = 0
rclone_remote=r2
rclone_dest_path=dht-backup/dht_crawler_backup
rclone_bookmark_path=data/rclone_backup_ids.txt

# ==== Categories To Save ====
# save_categories / save_tv_kinds: comma-separated taxonomy names (case-insensitive)
# selecting what ingest keeps; unknown names are logged and ignored. Both keys are
# written by the app's settings form, and are absent here on purpose: an unset or
# empty value saves everything.
#   save_categories = unknown,movie,tv,anime,music,audiobook,ebook,comic,software,game,image,other
#   save_tv_kinds = none,episode,multi_episode,season_pack,multi_season,complete_series,daily

# ==== Ingest-Time Classifier & Adult Handling ====
# Ingest-time fastText classifier (models/v3). The app stages the model files and
# the hard-block list next to this file; both path keys below are app-managed.
classifier_enabled=1
classifier_model_dir=models/v3
# adult_mode: tag (store adult rows; hidden at or above adult_hide_threshold) or
# drop (discard every adult-tagged row, i.e. anything at or above
# adult_hide_threshold). The hard-block list always drops.
adult_mode=tag
# 0 = take the threshold from models/v3/manifest.json (the app always writes a value).
adult_hide_threshold=0.653381
# Always-on name-substring block list (app-managed path key).
hard_block_file=hard_block.txt

# ==== Language Filter ====
# Filter torrents where non-Latin characters exceed this percentage
# of the total characters in the name and file list. (0=disabled, default: 33)
language_filter_non_latin_threshold=33

# ==== Supervisor-Level Bootstrap (cold start) ====
# When the BEP51 cache is empty (fresh data dir), the supervisor runs a
# parallel URL bootstrap to collect DHT nodes. After timeout, startup
# ABORTS if fewer than global_bootstrap_target nodes were found (the
# cache is saved for next attempt). On warm restart the cache is warm
# and this step is skipped entirely. Tuned for ~30-60s on a cold start.
global_bootstrap_target = 200
global_bootstrap_timeout_sec = 600
global_bootstrap_workers = 20

# ==== Thread Tree Architecture ====
num_trees = 32
use_keyspace_partitioning=1
dead_partition_threshold = 3
max_trees_per_partition = 4

# ==== Per-Tree Worker Counts (multiplied by num_trees) ====
# find_node workers per tree
tree_find_node_workers = 3
# BEP51 sample_infohashes workers per tree
tree_bep51_workers = 3
# get_peers workers per tree
tree_get_peers_workers = 18
# Metadata workers per tree
tree_metadata_workers = 12
# Infohash queue capacity per tree
tree_infohash_queue_capacity = 500
# BEP51 query interval in milliseconds
tree_bep51_query_interval_ms = 5
# BEP51 per-node query cooldown in seconds
bep51_node_cooldown_sec = 3
# Peers queue capacity per tree
tree_peers_queue_capacity = 500
# get_peers timeout per tree in milliseconds
tree_get_peers_timeout_ms = 1500
# get_peers lookup deadline per infohash in milliseconds
tree_get_peers_deadline_ms = 6000
# concurrent get_peers queries per round
tree_get_peers_fanout = 8
# total get_peers packets per infohash
tree_get_peers_max_queries = 16
# Peers to attempt in parallel per infohash
tree_parallel_peers = 4
# TCP connection establishment timeout in milliseconds
tree_tcp_connect_timeout_ms = 2000
# Process-wide UDP send rate limit in packets/sec (0 = unlimited)
udp_rate_limit_pps = 2500
# Fresh-peer re-lookup retries in the metadata failure path before a failure strike (0 = disable)
tree_metadata_fresh_peer_retries = 1
# Metadata fetch deadline per tree in milliseconds (5000-600000)
tree_metadata_timeout_ms = 60000

# ==== Rate-Based Respawn ====
min_metadata_rate = 0.005
dynamic_rate_margin = 0.01
tree_rate_check_interval_sec = 120
tree_rate_grace_period_sec = 30
tree_rate_ema_alpha = 0.3
tree_min_lifetime_minutes = 8
tree_require_empty_queue = 0

# ==== Respawn Overlapping Settings ====
respawn_spawn_threshold = 20
respawn_drain_timeout_sec = 180
max_draining_trees = 16

# ==== BEP51 Cache Settings ====
bep51_cache_path = data/bep51_cache.dat
bep51_cache_capacity = 50000
bep51_cache_submit_percent = 17

# ==== Refresh Thread Settings (for /refresh HTTP endpoint) ====
# refresh_retry_count: retries when /refresh returns 0 peers (0=no retry). Default: 1
refresh_retry_count = 1
refresh_bootstrap_sample_size = 1000
refresh_routing_table_target = 500
refresh_ping_workers = 1
refresh_find_node_workers = 1
refresh_get_peers_workers = 1
refresh_request_queue_capacity = 100
refresh_get_peers_timeout_ms = 500
refresh_max_iterations = 3
