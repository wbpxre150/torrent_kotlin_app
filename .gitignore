app/src/main/jniLibs/arm64-v8a/libcloudflared.so
.externalNativeBuild/
.cxx/

# Classifier weights (CRAM v15 + movie-kind v13 GGUF). Downloaded on-device by
# `dht_crawler --fetch-models` and sha256-verified, never bundled in the APK and
# never committed — a single generation is ~500 MB, far past GitHub's file limit.
app/src/main/cpp/dht_crawler-android/models/
*.gguf
*.ftz
*.cram

# Android capture/test artifacts
captures/
*.apk
*.aab
*.ap_
*.dex
*.class

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# The Gradle wrapper JAR *is* tracked: a fresh clone cannot run ./gradlew without it, and
# F-Droid reviewers expect the wrapper to work. It is the jar from gradle/gradle v8.14.3
# (sha256 7d3a4ac4de1c32b59bc6a4eb8ecb8e612ccd0cf1ae1e99f66902da64df296172), matching
# distributionUrl=gradle-8.14.3-bin.zip in gradle-wrapper.properties.

# graphify knowledge graph artifacts (regenerable via `graphify update .`)
graphify-out/

# Local agent / browser-automation artifacts (machine-specific, not project sources)
.pi/
.playwright-cli/
__pycache__/
*.pyc

# Release signing material — never commit, never publish. keystore.properties holds the
# store/key passwords in clear text and points at the .key file itself.
keystore.properties
*.jks
*.keystore
*.key
